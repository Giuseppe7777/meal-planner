{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center mb-4">Register</h1>

    
    {% if registrationForm.vars.errors|length > 0 %}
        <div class="alert alert-danger">
            {{ form_errors(registrationForm) }}
        </div>
    {% endif %}

    
        {# {{ form_start(registrationForm) }}
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                    {{ form_widget(registrationForm) }}
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg my-5">Register</button>
                </div>
            </div>
        </div>
        {{ form_end(registrationForm) }} #}

        {{ form_start(registrationForm, {'attr': {'id': 'registration_form'}}) }}
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">

                    <div class="form-group">
                        {# {{ form_errors(registrationForm.email) }} #}
                        {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                        <div id="email-feedback" class="form-text"></div> 
                        {{ form_widget(registrationForm.email) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(registrationForm.phoneNumber) }}
                        {{ form_widget(registrationForm.phoneNumber) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(registrationForm.first_name) }}
                        {{ form_widget(registrationForm.first_name) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(registrationForm.last_name) }}
                        {{ form_widget(registrationForm.last_name) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(registrationForm.imageFile) }}
                        <div class="registration-image-file-wrapper">                            
                            {{ form_widget(registrationForm.imageFile, {'attr': {'class': 'registration-image-file d-none', 'id': 'registration_form_imageFile'}}) }}
                            <div class="image-placeholder">
                                <img src="{{ asset('pictures/image-upload.png') }}" alt="Placeholder image">
                            </div>
                            <div class="registration-choose-file-wrapper">
                                <label for="registration_form_imageFile_file" class="file-label d-block text-center">
                                    Choose File
                                </label>
                                <span id="registration-image-file-name" class="registration-image-file-name d-block">No File Chosen</span>
                            </div>
                        </div>
                    </div>

                    {{ form_rest(registrationForm) }}

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg my-5">Register</button>
                    </div>
                </div>
            </div>
        {{ form_end(registrationForm) }}


</div>

{% endblock %}
