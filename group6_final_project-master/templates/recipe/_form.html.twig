{{ form_start(form) }}


<div class="form-section mb-4">
    <h3 class="section-title">Recipe Name</h3>
    {{ form_row(form.name) }}
</div>

<div class="form-section mb-4">
    <div class="recipe-types d-flex gap-2">
        {% for child in form.type %}
            {% set type_value = child.vars.value %}
            <label class="btn type-button tag--{{ type_value|lower }}">
                {{ form_widget(child) }} {{ child.vars.label | replace({'-': '&#8209;'})|raw }}
            </label>
        {% endfor %}
    </div>
</div>

<div class="form-section mb-4">
    <h3 class="section-title">Ingredients</h3>
    <div id="ingredients-container">
        <button type="button" id="add-ingredient" class="plus-image">
            <img src="{{ asset('pictures/plus.svg') }}">
        </button>
        <div class="ingredients-container__inner"> 
            <p class="ingredients-container__subtitle">Ingredient</p>
            {{ form_row(form.ingredients, {'attr': {'class': 'form-control-ingredients mb-2', 'placeholder': 'Enter an ingredient'}}) }}
        </div> 
    </div>
    <ul id="ingredients-list"></ul>
    <div id="ingredients-error" class="ingredients-error-flash mt-2" style="display: none;"></div>
</div>

<div class="form-section mb-4">
    <div class="form-control-description-wrapper">
        <h3 class="section-title--description">Description</h3>
        {{ form_row(form.description) }}
    </div>
</div>

<div class="form-section mb-4">
    <h3 class="section-title">Time</h3>
    <div class="d-flex flex-wrap gap-3">
        <div>{{ form_row(form.cooking_time) }}</div>
        <div>{{ form_row(form.preparation_time) }}</div>
    </div>
</div>


<div class="form-section mb-4">
    <h3 class="section-title-image">Add Image</h3>
    <div class="image-upload-container">
        <div class="image-placeholder">
            <img src="{{ asset('pictures/image-upload.png') }}" alt="Placeholder image">
        </div>
        <div class="image-upload-details">
            <p class="image-hint" id="image-hint">Please upload square image, size less than 2mb.</p>
            <div class="custom-file-upload">
                <label for="{{ form.photo.vars.id }}" class="file-label">
                    Choose File
                </label>
                {{ form_widget(form.photo, { 'attr': {'class': 'custom-file-input'} }) }}
                <span id="file-name" class="file-name">No File Chosen</span>
            </div>
        </div>
    </div>
</div>



<div class="form-section mb-4">
    <h3 class="section-title">Calories</h3>
    {{ form_row(form.calories) }}
</div>

<div class="form-section mb-4">
    <h3 class="section-title">Recipe Link</h3>
    {{ form_row(form.link) }}
</div>

<div class="form-actions mt-4">
    <button type="submit" class="btn btn-success">Save</button>
</div>


{{ form_end(form) }}


